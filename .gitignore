# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# QA — ephemeral run output only. QA-REPORT.md and visual baselines
# (qa/tests/visual/**/*-snapshots/) are intentionally NOT ignored: the
# report is the deliverable, and baselines are the golden reference images
# future runs diff against.
/qa/reports/html/
/qa/reports/test-results/
/qa/reports/results.json
/qa/reports/performance/
/qa/screenshots/
/test-results/
/playwright-report/
/blob-report/
